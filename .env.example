# Copiar a .env.local. Valores en Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (crear usuarios desde el panel admin). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Dominio al que apuntan los QR de las mesas. Se fija al compilar (en Dokploy, como build arg/env de build).
# Si falta, el QR usa el dominio desde donde se abre el admin.
NEXT_PUBLIC_QR_BASE_URL=https://demo.altiroqr.cl
